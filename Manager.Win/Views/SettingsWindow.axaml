<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Remotely.Manager.Win.Views.SettingsWindow"
        Width="460" Height="430"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Remotely Manager Settings">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="Remote Quality" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Changes are saved machine-wide and active remote sessions pick them up automatically." TextWrapping="Wrap" Opacity="0.75" />

      <TextBlock Text="Preset" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}" />

      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Image Quality" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ImageQuality}" />
        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="20" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ImageQuality, Mode=TwoWay}" />
      </Grid>

      <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max FPS" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding MaxFpsText}" />
        <NumericUpDown Grid.Row="1" Grid.ColumnSpan="2" Minimum="2" Maximum="30" Increment="1" Value="{Binding MaxFps, Mode=TwoWay}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <CheckBox Grid.Column="0" Content="Enable Audio" IsChecked="{Binding EnableAudio, Mode=TwoWay}" />
        <TextBlock Grid.Column="1" Text="{Binding AudioText}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Text="{Binding Warning}" Foreground="DarkOrange" TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorText" Foreground="Crimson" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
        <Button Grid.Column="0" Content="Restore Defaults" Click="RestoreDefaults_Click" />
        <Button Grid.Column="2" Content="Cancel" Margin="8,0" Click="Cancel_Click" />
        <Button Grid.Column="3" Content="Save / Apply" Click="Save_Click" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
